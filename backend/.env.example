# Copy this to .env and fill in your real values. NEVER commit .env to git.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL connection string from Supabase → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# JWT — use the same JWT secret shown in Supabase → Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret

# App
APP_ENV=development
SECRET_KEY=change-this-to-a-random-string
